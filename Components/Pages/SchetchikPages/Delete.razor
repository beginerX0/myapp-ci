@page "/schetchiks/delete"
@using Microsoft.EntityFrameworkCore
@using _1lab.Data
@inject IDbContextFactory<_1lab.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@code {

    [SupplyParameterFromQuery]
    private int SchetchikId { get; set; }

    [SupplyParameterFromQuery]
    private int AbonentId { get; set; }

    private Schetchik? schetchik;
    private Abonent? abonent = default;

    private ApplicationDbContext context = default!;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        schetchik = await context.Schetchiks.FirstOrDefaultAsync(m => m.SchetchikId == SchetchikId);
        abonent = await context.Abonents.FirstOrDefaultAsync(m => m.AbonentId == schetchik.AbonentId);

        if (schetchik is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteSchetchik()
    {
        using var context = DbFactory.CreateDbContext();
        context.Schetchiks.Remove(schetchik!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/schetchiks");
    }
}

<PageTitle>Удалить показание</PageTitle>

<h1>Удалить показание</h1>

<p>Вы уверены?</p>
<div>
    <hr />
    @if (schetchik is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Номер</dt>
            <dd class="col-sm-10">@schetchik.Number</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Тип</dt>
            <dd class="col-sm-10">@schetchik.Type</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Дата установки</dt>
            <dd class="col-sm-10">@schetchik.LaunchData</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Абонент</dt>
            <dd class="col-sm-10">@abonent.getFullName()</dd>
        </dl>
        <EditForm method="post" Model="schetchik" OnValidSubmit="DeleteSchetchik" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(schetchik is null)">Удалить</button> |
            <a href="/schetchiks?abonentid=@($"{AbonentId}")">Возврат к списку счетчиков</a>
        </EditForm>
    }
</div>

